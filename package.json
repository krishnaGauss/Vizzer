{
  "name": "vizzer",
  "icon": "media/logo.png",
  "displayName": "Vizzer — Claude Token Optimizer & Visualizer",
  "description": "Live per-session token and context usage for Claude Code, with one-click handoffs into a fresh session (written by Opus by default, or any model you pick), for context length and token optimization.",
  "version": "0.1.3",
  "publisher": "vizzer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/krishnaGauss/Vizzer.git"
  },
  "homepage": "https://github.com/krishnaGauss/Vizzer#readme",
  "bugs": {
    "url": "https://github.com/krishnaGauss/Vizzer/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "tokens",
    "context window",
    "handoff"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vizzer",
          "title": "Vizzer",
          "icon": "media/vizzer.svg"
        }
      ]
    },
    "views": {
      "vizzer": [
        {
          "type": "webview",
          "id": "vizzer.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "vizzer.showPanel",
        "title": "Show Token Panel",
        "category": "Vizzer"
      },
      {
        "command": "vizzer.createHandoff",
        "title": "Create Handoff for Current Session",
        "category": "Vizzer",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "vizzer.startSessionFromHandoff",
        "title": "Start New Claude Session from This Handoff",
        "category": "Vizzer",
        "icon": "$(play)"
      },
      {
        "command": "vizzer.selectHandoffModel",
        "title": "Choose Model That Writes Handoffs…",
        "category": "Vizzer",
        "icon": "$(sparkle)"
      },
      {
        "command": "vizzer.selectSession",
        "title": "Select Session…",
        "category": "Vizzer",
        "icon": "$(list-selection)"
      },
      {
        "command": "vizzer.followLatest",
        "title": "Follow Most Recent Session",
        "category": "Vizzer"
      },
      {
        "command": "vizzer.openTranscript",
        "title": "Open Session Transcript",
        "category": "Vizzer"
      },
      {
        "command": "vizzer.refresh",
        "title": "Refresh",
        "category": "Vizzer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vizzer.selectHandoffModel",
          "when": "view == vizzer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "vizzer.selectSession",
          "when": "view == vizzer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "vizzer.refresh",
          "when": "view == vizzer.sessions",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "vizzer.startSessionFromHandoff",
          "when": "resourcePath =~ /\\.vizzer[\\/\\\\]handoffs[\\/\\\\][^\\/\\\\]+\\.md$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Vizzer",
      "properties": {
        "vizzer.thresholds.warnTokens": {
          "type": "number",
          "default": 150000,
          "minimum": 1000,
          "markdownDescription": "Warn when a session re-sends at least this many context tokens per message."
        },
        "vizzer.thresholds.criticalTokens": {
          "type": "number",
          "default": 300000,
          "minimum": 1000,
          "markdownDescription": "Mark a session critical (and suggest a handoff) at this many context tokens per message."
        },
        "vizzer.thresholds.warnPercent": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Warn when the context window is at least this full (percent)."
        },
        "vizzer.thresholds.criticalPercent": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Mark a session critical when the context window is at least this full (percent)."
        },
        "vizzer.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a notification offering a handoff when a session crosses a threshold."
        },
        "vizzer.contextWindowOverride": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "Force the context window size in tokens (e.g. `200000` or `1000000`). `0` detects it from the model."
        },
        "vizzer.claudeConfigDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Claude Code config directory. Empty uses `CLAUDE_CONFIG_DIR` or `~/.claude`."
        },
        "vizzer.claudePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `claude` CLI used to generate handoffs. Empty searches `PATH` and common install locations."
        },
        "vizzer.handoff.model": {
          "type": "string",
          "default": "opus",
          "markdownDescription": "Model that writes handoff files. `opus` (default) keeps the most detail, `sonnet` is a faster middle ground and `haiku` is the quickest and cheapest. A full model ID such as `claude-sonnet-5` also works. Run **Vizzer: Choose Model That Writes Handoffs…** to pick one from a list."
        },
        "vizzer.handoff.maxDigestTokens": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "maximum": 150000,
          "markdownDescription": "Approximate token budget for the condensed transcript sent to the handoff model."
        },
        "vizzer.handoff.openIn": {
          "type": "string",
          "enum": [
            "claudeExtension",
            "terminal"
          ],
          "enumDescriptions": [
            "Open a new tab in the Claude Code extension with the prompt pre-filled.",
            "Start `claude` in an integrated terminal."
          ],
          "default": "claudeExtension",
          "markdownDescription": "Where to start the new session after a handoff."
        },
        "vizzer.sessions.historyDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "markdownDescription": "Only load sessions active within this many days."
        },
        "vizzer.sessions.maxSessions": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "markdownDescription": "Maximum number of sessions to track per workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/webview",
    "lint": "eslint src test bench",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "bench:build": "node bench/build.mjs",
    "bench:run": "npm run bench:build && node bench/dist/run.cjs",
    "bench:overhead": "npm run bench:build && node bench/dist/overhead.cjs",
    "bench:report": "npm run bench:build && node bench/dist/report.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
